# Copy this file to .env.local and fill in your own values.
# Find them in Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Largest video upload, in MB. Leave at 50 on Supabase's free plan. On Supabase Pro, set
# it to 500 and run supabase/migrations/20261023100000_bigger_uploads.sql.
NEXT_PUBLIC_MAX_VIDEO_MB=50

# Server-only secrets (never commit real values)
TOKEN_ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32-base64
SUPABASE_SECRET_KEY=sb_secret_your_key_here
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Threads: from the Meta app's "Access the Threads API" use case. These are NOT the
# same as the Facebook app ID and secret above.
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
# LinkedIn: linkedin.com/developers > your app > Auth. Add the products "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Pinterest: developers.pinterest.com > My apps > your app (App ID and App secret key).
PINTEREST_APP_ID=your-pinterest-app-id
PINTEREST_APP_SECRET=your-pinterest-app-secret
# Keep 1 until Pinterest gives the app "Standard access": it uses Pinterest's sandbox, where
# Pins are only visible to you. Remove it (here and on Vercel) once approved, then reconnect.
PINTEREST_SANDBOX=1
# AI Caption Writer. Create one at console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Email alerts. Create one at resend.com > API Keys. Without it, emails are printed
# in the dev server window instead. EMAIL_FROM needs a domain verified in Resend.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=SocialFlow <alerts@your-domain.com>

# Local only: use the Inngest Dev Server on this computer. Do NOT set this on Vercel.
INNGEST_DEV=1
