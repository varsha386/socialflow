# Copy this file to .env.local and fill in your own values.
# Find them in Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only secrets (never commit real values)
TOKEN_ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32-base64
SUPABASE_SECRET_KEY=sb_secret_your_key_here
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Local only: use the Inngest Dev Server on this computer. Do NOT set this on Vercel.
INNGEST_DEV=1
